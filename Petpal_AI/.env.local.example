# Local development configuration. Copy this file to .env.local and fill in values.
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# MySQL running directly on your computer
DB_NAME=petpal_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ChromaDB running directly on your computer
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Required for the AI chat and AI description features
GOOGLE_API_KEY=

# Optional: required only when sending password-reset emails
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
